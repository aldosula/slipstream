<Project>
  <!-- Shared settings for every project in the Slipstream Windows solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.2.0</Version>
    <Product>Slipstream</Product>
    <Copyright>Slipstream</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Server GC is wrong for a latency app with tiny heaps; keep workstation, concurrent. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
