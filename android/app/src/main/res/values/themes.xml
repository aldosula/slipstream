<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Slipstream" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:colorControlNormal">@color/text_muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:alertDialogTheme">@style/Theme.Slipstream.Dialog</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Slipstream.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:colorControlNormal">@color/text_muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <style name="Theme.Slipstream.Drive">
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
